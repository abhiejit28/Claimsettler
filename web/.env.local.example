# Server-side only — Route Handler proxy target, never exposed to the browser.
API_BASE_URL=http://localhost:8000

# Client-visible: same-origin proxy path, always what claimsApi.* targets.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# --- Single-tenant theming (lib/theme/tenant-config.ts) ---
NEXT_PUBLIC_TENANT_ID=claimsettler-default
NEXT_PUBLIC_TENANT_NAME=ClaimSettler
NEXT_PUBLIC_TENANT_LOGO_URL=/logo.svg
NEXT_PUBLIC_TENANT_FAVICON_URL=/favicon.ico
NEXT_PUBLIC_TENANT_SUPPORT_EMAIL=support@example.com
# Full CSS color values (this project's shadcn theme uses oklch(...) directly).
NEXT_PUBLIC_TENANT_PRIMARY_COLOR=oklch(0.205 0 0)
NEXT_PUBLIC_TENANT_PRIMARY_FOREGROUND_COLOR=oklch(0.985 0 0)
