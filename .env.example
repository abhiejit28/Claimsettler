# Copy to .env and fill in real values. All provider vars default to "fake"
# so the system runs fully locally with zero credentials — see
# docs/architecturePlan.md "Decisions confirmed" for the pluggability design.

# --- Database ---
# Local dev/test default (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./claimsettler.db
# Docker-compose / production:
# DATABASE_URL=postgresql+asyncpg://claimsettler:claimsettler@localhost:5432/claimsettler

# --- MCP server addresses ---
MCP_KMA_URL=http://localhost:8100/mcp
MCP_FRAUD_AGENT_URL=http://localhost:8101/mcp
MCP_COMPLIANCE_AGENT_URL=http://localhost:8102/mcp

# --- Provider selection ---
EMBEDDING_PROVIDER=fake      # bge_m3 | fake
VECTOR_STORE=fake            # pinecone | fake
RERANKER=fake                # bge_reranker | fake
LLM_PROVIDER=fake            # anthropic | fake
PII_DETECTOR=presidio        # presidio | regex_only

# --- Pinecone (required if VECTOR_STORE=pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX=claimsettler-kma

# --- Anthropic (required if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- CORS (frontend) ---
CORS_ALLOW_ORIGINS=http://localhost:3000
